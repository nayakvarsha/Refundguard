# Razorpay API Credentials (Global Fallback or Test Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Razorpay Partner OAuth Credentials (For Production OAuth Flow)
RAZORPAY_CLIENT_ID=your_partner_client_id
RAZORPAY_CLIENT_SECRET=your_partner_client_secret
RAZORPAY_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/razorpay/callback

# Application Configuration
PORT=4000
PUBLIC_URL=http://localhost:4000
ADMIN_PASSWORD=your_admin_password_here
